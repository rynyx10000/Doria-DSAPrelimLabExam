class Song:
    def __init__(self, song_id, title, artist, duration):
        self.song_id = song_id
        self.title = title
        self.artist = artist
        self.duration = duration

    def __str__(self):
        return f"ID: {self.song_id} | Title: {self.title} | Artist: {self.artist} | Duration: {self.duration}"

class Node:
    def __init__(self, song):
        self.data = song
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None
        self.size = 0

    def insert_first(self, song):
        new_node = Node(song)
        new_node.next = self.head
        self.head = new_node
        self.size += 1
        print("Song added at beginning.")

    def insert_last(self, song):
        new_node = Node(song)
        if not self.head:
            self.head = new_node
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = new_node
        self.size += 1
        print("Song added at end.")

    def insert_at(self, song, position):
        if position < 1 or position > self.size + 1:
            print("Invalid position!")
            return
        if position == 1:
            self.insert_first(song)
            return

        new_node = Node(song)
        temp = self.head
        for _ in range(1, position - 1):
            temp = temp.next
        new_node.next = temp.next
        temp.next = new_node
        self.size += 1
        print(f"Song inserted at position {position}.")

    def display(self):
        if not self.head:
            print("Playlist is empty.")
            return
        temp = self.head
        while temp:
            print(temp.data)
            temp = temp.next
        print(f"Total Songs: {self.size}")

    def search(self, song_id):
        temp = self.head
        while temp:
            if temp.data.song_id.lower() == song_id.lower():
                return temp.data
            temp = temp.next
        return None

    def delete(self, song_id):
        if not self.head:
            return False

        if self.head.data.song_id.lower() == song_id.lower():
            self.head = self.head.next
            self.size -= 1
            return True

        temp = self.head
        while temp.next and temp.next.data.song_id.lower() != song_id.lower():
            temp = temp.next

        if temp.next:
            temp.next = temp.next.next
            self.size -= 1
            return True
        return False

def main():
    playlist = LinkedList()
    while True:
        print("================================")
        print("     MUSIC PLAYLIST MANAGER")
        print("================================")
        print("1. Add Song at Beginning\n2. Add Song at End\n3. Insert Song at Position")
        print("4. Display Playlist\n5. Search Song\n6. Remove Song")
        print("7. Display Playlist Size\n8. Exit")
        choice = input("Enter your choice:")

        if choice in ['1', '2', '3']:
            s_id = input("Enter Song ID: ")
            title = input("Enter Song Title: ")
            artist = input("Enter Artist: ")
            duration = input("Enter Duration: ")
            song = Song(s_id, title, artist, duration)

            if choice == '1':
                playlist.insert_first(song)
            elif choice == '2':
                playlist.insert_last(song)
            elif choice == '3':
                pos = int(input("Enter Position: "))
                playlist.insert_at(song, pos)
        elif choice == '4':
            playlist.display()
        elif choice == '5':
            s_id = input("Enter Song ID to Search: ")
            found = playlist.search(s_id)
            print(f"Found: {found}" if found else "Song not found.")
        elif choice == '6':
            s_id = input("Enter Song ID to Remove: ")
            print("Removed successfully." if playlist.delete(s_id) else "Song not found.")
        elif choice == '7':
            print(f"Total Songs: {playlist.size}")
        elif choice == '8':
            print("Exiting...")
            break

if __name__ == "__main__":
    main()
